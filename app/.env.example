# Copy to .env.local. Never share production credentials with previews.
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DEMO_MODE=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visionarytalks
PAYLOAD_SECRET=
# Private S3-compatible bucket. Keep public bucket access disabled.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CRON_SECRET=
# Provider adapter credentials are intentionally unset until an approved provider is connected.
CONTENT_PROVIDER_URL=
CONTENT_PROVIDER_TOKEN=
IMAGE_PROVIDER_URL=
IMAGE_PROVIDER_TOKEN=
# Optional built-in OpenAI adapters. Set explicit approved models; no automatic model substitution.
CONTENT_PROVIDER=
IMAGE_PROVIDER=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_ORCHESTRATOR_MODEL=
OPENAI_IMAGE_MODEL=
